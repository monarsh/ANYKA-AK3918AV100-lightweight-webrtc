# Build-test fragment: replaces the vendor toolchain with Debian/Ubuntu's
# armel cross compiler (ARMv5TE, glibc) so the packaging can be tested on
# any PC. Used by scripts/build-test.sh together with a mock SDK.
# The result cannot run on the camera (wrong C library).
BR2_TOOLCHAIN_EXTERNAL_PATH="/usr"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-linux-gnueabi"
# BR2_TOOLCHAIN_EXTERNAL_GCC_5 is not set
BR2_TOOLCHAIN_EXTERNAL_GCC_13=y
# BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_4 is not set
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_8=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
