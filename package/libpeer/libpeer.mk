################################################################################
#
# libpeer
#
################################################################################

LIBPEER_VERSION = 5b849de378545c31d34759a145413846953e1366
LIBPEER_SITE = https://github.com/sepfy/libpeer.git
LIBPEER_SITE_METHOD = git
# mbedtls, libsrtp, cJSON, coreHTTP, coreMQTT (and usrsctp) are submodules
LIBPEER_GIT_SUBMODULES = YES
LIBPEER_LICENSE = MIT
LIBPEER_LICENSE_FILES = LICENSE
LIBPEER_INSTALL_STAGING = YES
LIBPEER_SUPPORTS_IN_SOURCE_BUILD = NO

LIBPEER_KEEPALIVE_MS = $(BR2_PACKAGE_LIBPEER_KEEPALIVE_MS)
LIBPEER_CFLAGS = \
	$(TARGET_CFLAGS) \
	-DLOG_LEVEL=1 \
	-DCONFIG_STUN_KEEPALIVE_INTERVAL=$(LIBPEER_KEEPALIVE_MS) \
	-DCONFIG_STUN_KEEPALIVE_TIMEOUT=$(LIBPEER_KEEPALIVE_MS)*3+1

LIBPEER_CONF_OPTS = \
	-DBUILD_SHARED_LIBS=ON \
	-DBUILD_EXAMPLES=OFF \
	-DENABLE_TESTS=OFF \
	-DVIDEO_FPS=$(BR2_PACKAGE_LIBPEER_VIDEO_FPS) \
	-DCMAKE_C_FLAGS="$(LIBPEER_CFLAGS)"

ifeq ($(BR2_PACKAGE_LIBPEER_USRSCTP),y)
LIBPEER_CONF_OPTS += -DENABLE_USRSCTP=ON
else
LIBPEER_CONF_OPTS += -DENABLE_USRSCTP=OFF
endif

$(eval $(cmake-package))
